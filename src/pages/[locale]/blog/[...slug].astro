---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { locales, type Locale } from '../../../i18n/ui';
import { localizedContent, contentKey } from '../../../i18n/content';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return (Object.keys(locales) as Locale[]).flatMap((locale) =>
		localizedContent(posts, locale)
			.map((post) => ({
				params: { locale, slug: contentKey(post) },
				props: { locale, post },
			})),
	);
}

type Props = {
	locale: Locale;
	post: CollectionEntry<'blog'>;
};

const { locale, post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} locale={locale}>
	<Content />
</BlogPost>