---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_DESCRIPTION } from '../../../consts';
import { localeParams } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import Layout from '../../../layouts/Layout.astro';

export function getStaticPaths() {
	return localeParams();
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getCollection('blog', ({ data }) => data.lang === locale)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={t('blog.title')} description={SITE_DESCRIPTION[locale]} locale={locale}>
	<section class="section-shell">
		<div class="site-container">
		<p class="eyebrow">{t('blog.eyebrow')}</p>
		<h1 class="section-title">{t('blog.title')}</h1>
		<p class="section-copy">{t('blog.subtitle')}</p>

		{
			posts.length === 0 ? (
				<p
					class="mt-10 rounded-2xl border border-dashed border-[var(--line)] p-10 text-center text-[var(--muted)]"
				>
					{t('blog.empty')}
				</p>
			) : (
				<ul class="mt-10 grid gap-6 sm:grid-cols-2">
					{
						posts.map((post) => (
							<li>
								<a
									href={`/${locale}/blog/${post.id.split('/').pop()}/`}
									class="panel group flex h-full flex-col overflow-hidden rounded-3xl transition duration-300 hover:-translate-y-1 hover:border-[var(--brand)] hover:shadow-xl"
								>
									{
										post.data.heroImage && (
											<div class="overflow-hidden">
												<Image
													src={post.data.heroImage}
													alt=""
													width={640}
													height={360}
													class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-105"
												/>
											</div>
										)
									}
										<div class="flex flex-1 flex-col gap-2 p-6">
											<p class="text-xs font-bold uppercase tracking-wider text-[var(--brand)]">
											<FormattedDate date={post.data.pubDate} locale={locale} />
										</p>
										<h2
												class="text-xl font-bold tracking-tight text-[var(--ink)] transition-colors group-hover:text-[var(--brand)]"
										>
											{post.data.title}
										</h2>
											<p class="leading-7 text-[var(--muted)]">
											{post.data.description}
										</p>
											<span class="mt-auto pt-3 text-sm font-bold text-[var(--brand)]">
											{t('blog.readMore')} &rarr;
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			)
		}
		</div>
	</section>
</Layout>
