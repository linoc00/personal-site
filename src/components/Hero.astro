---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section id="home" class="hero-section">
	<div class="site-container hero-layout">
		<div>
			<p class="eyebrow">{t('hero.eyebrow')}</p>
			<p class="hero-name">{t('hero.name')}</p>
			<h1 class="hero-title">{t('hero.title')}</h1>
			<p class="hero-copy">{t('hero.body')}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href={getRelativeLocaleUrl(locale, '/progetti/')} class="button-primary">{t('hero.cta_projects')} <span aria-hidden="true">↗</span></a>
				<a href={getRelativeLocaleUrl(locale, '/didattica/')} class="button-secondary">{t('hero.cta_materials')} <span aria-hidden="true">→</span></a>
			</div>
		</div>
		<aside class="approach-card">
			<div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-[.16em]">{t('hero.note')}</span><span class="font-mono text-sm opacity-60" aria-hidden="true">PC / 01</span></div>
			<div class="approach-symbol" aria-hidden="true"><span>{'{'}</span><span class="symbol-dot"></span><span>{'}'}</span></div>
			<h2>{t('hero.note_title')}</h2>
			<p>{t('hero.note_body')}</p>
			<div class="approach-footer"><span>Teaching</span><span aria-hidden="true">↔</span><span>Development</span></div>
		</aside>
	</div>
</section>
