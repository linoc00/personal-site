---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, '/');
const materials = getRelativeLocaleUrl(locale, '/didattica/');
const blog = getRelativeLocaleUrl(locale, '/blog/');
const navItems = [
	{ label: t('nav.materials'), href: materials },
	{ label: t('nav.projects'), href: getRelativeLocaleUrl(locale, '/progetti/') },
	{ label: t('nav.experience'), href: `${home}#esperienza` },
	{ label: t('nav.blog'), href: blog },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[color:color-mix(in_srgb,var(--surface)_88%,transparent)] backdrop-blur-xl">
	<nav class="site-container flex min-h-18 items-center gap-4" aria-label="Main">
		<a href={home} class="group flex shrink-0 items-center gap-3" aria-label="Pasquale Cerullo — Home">
			<span class="grid h-9 w-9 place-items-center rounded-xl bg-ink text-sm font-bold tracking-tight text-white shadow-sm transition-transform group-hover:-rotate-3 dark:bg-white dark:text-ink">PC</span>
			<span class="hidden leading-tight sm:block"><span class="block text-sm font-bold text-[var(--ink)]">Pasquale Cerullo</span><span class="block text-xs text-[var(--muted)]">Teacher · Developer</span></span>
		</a>

		<div class="ml-auto hidden items-center gap-1 lg:flex">
			{navItems.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined} class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--muted)] transition-colors aria-[current=page]:text-[var(--brand)] aria-[current=page]:bg-[var(--brand-soft)] hover:bg-[var(--brand-soft)] hover:text-[var(--ink)]">{item.label}</a>)}
		</div>

		<div class="ml-auto flex items-center gap-2 lg:ml-3">
			<button type="button" data-search-open aria-label={t('search.label')} class="flex h-10 items-center gap-2 rounded-xl border border-[var(--line)] bg-[var(--surface-strong)] px-3 text-sm font-medium text-[var(--muted)] transition-colors hover:border-[var(--brand)] hover:text-[var(--ink)]">
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
				<span class="hidden md:inline">{t('search.label')}</span><kbd class="hidden rounded border border-[var(--line)] bg-[var(--surface)] px-1.5 py-0.5 font-sans text-[11px] sm:inline">⌘ K</kbd>
			</button>
			<div class="hidden xl:block"><ThemeToggle locale={locale} /></div>
			<div class="hidden sm:block"><LangSwitch locale={locale} /></div>
			<button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={t('nav.menu')} class="grid h-10 w-10 place-items-center rounded-xl border border-[var(--line)] text-[var(--ink)] lg:hidden">
				<svg data-menu-open-icon viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
				<svg data-menu-close-icon viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18" /></svg>
			</button>
		</div>
	</nav>
	<div id="mobile-menu" hidden class="border-t border-[var(--line)] bg-[var(--surface-strong)] lg:hidden">
		<div class="site-container grid gap-1 py-4">
			{navItems.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined} class="rounded-xl px-3 py-3 text-base font-semibold text-[var(--ink)] hover:bg-[var(--brand-soft)]">{item.label}</a>)}
			<div class="mt-3 flex items-center justify-between border-t border-[var(--line)] pt-4 sm:justify-start sm:gap-3"><ThemeToggle locale={locale} /><div class="sm:hidden"><LangSwitch locale={locale} /></div></div>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector('[data-menu-toggle]');
	const menu = document.querySelector('#mobile-menu');
	const openIcon = toggle?.querySelector('[data-menu-open-icon]');
	const closeIcon = toggle?.querySelector('[data-menu-close-icon]');
	function setMenu(open: boolean) {
		if (!toggle || !menu) return;
		toggle.setAttribute('aria-expanded', String(open));
		menu.toggleAttribute('hidden', !open);
		openIcon?.classList.toggle('hidden', open);
		closeIcon?.classList.toggle('hidden', !open);
	}
	toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
</script>
