---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { profile } from '../data/portfolio';
import { useTranslations, type Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const home = getRelativeLocaleUrl(locale, '/');
const links = [
	{ label: t('nav.materials'), href: getRelativeLocaleUrl(locale, '/didattica/') },
	{ label: t('nav.projects'), href: `${home}#progetti` },
	{ label: t('nav.blog'), href: getRelativeLocaleUrl(locale, '/blog/') },
	{ label: t('nav.contact'), href: `${home}#contatti` },
];
---
<footer class="border-t border-[var(--line)] bg-[var(--surface-strong)]">
	<div class="site-container grid gap-10 py-12 md:grid-cols-[1fr_auto] md:items-start">
		<div class="max-w-md"><a href={home} class="inline-flex items-center gap-3 font-bold text-[var(--ink)]"><span class="grid h-9 w-9 place-items-center rounded-xl bg-ink text-sm text-white dark:bg-white dark:text-ink">PC</span>{profile.name}</a><p class="mt-4 leading-7 text-[var(--muted)]">{t('footer.description')}</p></div>
		<div><p class="text-xs font-bold uppercase tracking-[.14em] text-[var(--muted)]">{t('footer.explore')}</p><nav class="mt-4 grid grid-cols-2 gap-x-8 gap-y-3" aria-label="Footer">{links.map((link) => <a href={link.href} class="text-sm font-semibold text-[var(--ink)] hover:text-[var(--brand)]">{link.label}</a>)}</nav></div>
	</div>
	<div class="border-t border-[var(--line)]"><div class="site-container flex flex-col gap-3 py-5 text-sm text-[var(--muted)] sm:flex-row sm:items-center sm:justify-between"><p>© {year} {profile.name}</p><p>{t('footer.made_with')}</p></div></div>
</footer>
