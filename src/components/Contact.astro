---
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import { profile } from '../data/portfolio';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const hasPublicEmail = !profile.email.endsWith('@example.com');
const visibleSocials = profile.socials.filter((social) => social.href !== 'https://linkedin.com/');
---

<section id="contatti" class="section-shell scroll-mt-20">
	<div class="site-container">
	<div class="relative overflow-hidden rounded-[2rem] bg-ink p-8 text-white shadow-2xl sm:p-12 lg:grid lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12 dark:bg-white dark:text-ink">
		<div class="absolute -right-24 -top-32 h-80 w-80 rounded-full border-[3rem] border-white/5 dark:border-ink/5"></div>
		<div class="relative"><p class="text-xs font-bold uppercase tracking-[.16em] text-blue-300 dark:text-brand-600">{t('contact.eyebrow')}</p>
		<h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-[-.04em] sm:text-5xl">
			{t('contact.title')}
		</h2>
		<p class="mt-4 max-w-xl text-lg leading-8 text-slate-300 dark:text-slate-600">
			{t('contact.subtitle')}
		</p>
		</div>
		<div class="relative mt-8 flex flex-wrap gap-3 lg:mt-0 lg:justify-end">
			{hasPublicEmail && <a
				href={`mailto:${profile.email}`}
				class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-brand-500"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
				</svg>
				{t('contact.email')}
			</a>}

			{
				visibleSocials.map((social) => (
					<a
						href={social.href}
						target="_blank"
						rel="me noreferrer"
						class="inline-flex items-center gap-2 rounded-xl border border-white/20 px-5 py-3 text-sm font-bold text-white transition hover:bg-white/10 dark:border-ink/20 dark:text-ink dark:hover:bg-ink/5"
					>
						{social.icon === 'github' ? (
							<svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
								<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
							</svg>
						) : (
							<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
							</svg>
						)}
						{social.label}
					</a>
				))
			}
		</div>
	</div>
	</div>
</section>
