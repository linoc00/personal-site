---
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../i18n/ui';
import type { Project } from '../data/portfolio';

interface Props {
	project: Project;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
---

<article class="panel group flex flex-col overflow-hidden rounded-3xl transition duration-300 hover:-translate-y-1 hover:border-[var(--brand)] hover:shadow-xl">
	{
		project.image && (
			<div class="overflow-hidden">
				<Image
					src={project.image}
					alt=""
					width={640}
					height={360}
					class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
				/>
			</div>
		)
	}
	<div class="flex flex-1 flex-col gap-3 p-6">
		<h3 class="text-xl font-bold tracking-tight text-[var(--ink)]">
			{project.title[locale]}
		</h3>
		<p class="leading-7 text-[var(--muted)]">
			{project.description[locale]}
		</p>
		<div class="mt-1 flex flex-wrap gap-1.5">
			{
				project.tech.map((tech) => (
					<span class="rounded-full border border-[var(--line)] bg-[var(--surface)] px-2.5 py-1 text-xs font-semibold text-[var(--muted)]">
						{tech}
					</span>
				))
			}
		</div>
		<div class="mt-auto flex flex-wrap gap-4 border-t border-[var(--line)] pt-4 text-sm font-bold">
			{
				project.liveUrl && (
					<a
						href={project.liveUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[var(--brand)] transition-colors hover:underline"
					>
						{project.pdfUrl ? t('project.guide') : t('project.live')} &rarr;
					</a>
				)
			}
			{
				project.pdfUrl && (
					<a
						href={project.pdfUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[var(--muted)] transition-colors hover:text-[var(--ink)]"
					>
						{t('project.pdf')}
					</a>
				)
			}
			{
				project.repoUrl && (
					<a
						href={project.repoUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[var(--muted)] transition-colors hover:text-[var(--ink)]"
					>
						{t('project.source')}
					</a>
				)
			}
		</div>
	</div>
</article>
