---
import { useTranslations, type Locale } from '../i18n/ui';
import type { Project } from '../data/portfolio';
interface Props { project: Project; locale: Locale; headingLevel?: 'h2' | 'h3'; }
const { project, locale, headingLevel: Heading = 'h3' } = Astro.props;
const t = useTranslations(locale);
const date = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(project.publishedAt));
const liveUrl = project.liveUrl === '/2048/' ? `/2048/?lang=${locale}` : project.liveUrl;
const hasLinks = project.liveUrl || project.pdfUrl || project.repoUrl;
---
<article id={project.slug} class="project-card panel scroll-mt-24">
	<div class="project-cover" data-project={project.slug} aria-hidden="true">
		{project.slug === '2048' ? <div class="mini-board"><span>2</span><span>4</span><span>8</span><span>2048</span></div> : <span class="project-glyph">{project.slug === 'e-commerce' ? 'shop.' : project.slug === 'analytics' ? 'data.' : project.slug === 'task-manager' ? 'done.' : 'hello.'}</span>}
		<span class="cover-caption">{project.tech.slice(0, 2).join(' / ')}</span>
	</div>
	<div class="flex flex-1 flex-col gap-4 p-6">
		<p class="text-xs text-[var(--muted)]">{t('projects.published')} <time datetime={project.publishedAt}>{date}</time></p>
		<Heading class="text-xl font-bold tracking-tight text-[var(--ink)]">{project.title[locale]}</Heading>
		<p class="leading-7 text-[var(--muted)]">{project.description[locale]}</p>
		<ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label={locale === 'it' ? 'Tecnologie' : 'Technologies'}>{project.tech.map((tech) => <li class="tech-tag">{tech}</li>)}</ul>
		{hasLinks && <div class="flex flex-wrap gap-4 border-t border-[var(--line)] pt-4 text-sm font-bold">
			{project.liveUrl && <a href={liveUrl} target={project.liveUrl.startsWith('/') ? undefined : '_blank'} rel={project.liveUrl.startsWith('/') ? undefined : 'noopener noreferrer'} class="text-[var(--brand)] hover:underline">{project.pdfUrl ? t('project.guide') : t('project.live')} <span aria-hidden="true">↗</span></a>}
			{project.pdfUrl && <a href={project.pdfUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--muted)] hover:underline">{t('project.pdf')}</a>}
			{project.repoUrl && <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--muted)] hover:underline">{t('project.source')}</a>}
		</div>}
	</div>
</article>
