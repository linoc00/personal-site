---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';
interface Props { material: CollectionEntry<'materials'>; locale: Locale; featured?: boolean; }
const { material, locale, featured = false } = Astro.props;
const t = useTranslations(locale);
const { data } = material;
const date = new Intl.DateTimeFormat(locale, { month: 'short', year: 'numeric' }).format(data.updatedDate);
const icon = data.format === 'guide' ? '01' : data.format === 'exercise' ? '02' : data.format === 'slides' ? '03' : '04';
---
<article data-material-card data-topics={data.topics.join('|')} class:list={["panel group relative flex h-full flex-col overflow-hidden rounded-3xl p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--brand)] hover:shadow-xl sm:p-7", featured && "md:grid md:grid-cols-[1fr_auto] md:gap-10"]}>
	<div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-600 via-blue-400 to-mint opacity-80"></div>
	<div>
		<div class="flex items-center gap-3 text-xs font-bold uppercase tracking-[.13em] text-[var(--brand)]"><span class="grid h-9 w-9 place-items-center rounded-xl bg-[var(--brand-soft)] font-mono tracking-normal">{icon}</span><span>{data.category}</span></div>
		<h3 class:list={["mt-6 font-bold tracking-tight text-[var(--ink)]", featured ? "text-2xl sm:text-3xl" : "text-xl"]}>{data.title}</h3>
		<p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{data.description}</p>
		<div class="mt-5 flex flex-wrap gap-2">{data.topics.map((topic) => <span class="rounded-full border border-[var(--line)] bg-[var(--surface)] px-3 py-1 text-xs font-semibold text-[var(--muted)]">{topic}</span>)}</div>
	</div>
	<div class:list={["mt-8 flex flex-col justify-between gap-5 border-t border-[var(--line)] pt-5", featured && "md:mt-0 md:min-w-48 md:border-l md:border-t-0 md:pl-8 md:pt-0"]}>
		<div class="space-y-1 text-sm text-[var(--muted)]"><p class="font-semibold text-[var(--ink)]">{data.level}</p><p>{t('materials.updated')} {date}</p></div>
		<div class="flex flex-wrap gap-3 md:flex-col">
			<a href={data.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-brand-700">{t('materials.open')} <span aria-hidden="true">↗</span></a>
			{data.downloadHref && <a href={data.downloadHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl border border-[var(--line)] px-4 py-2.5 text-sm font-bold text-[var(--ink)] transition hover:border-[var(--brand)]">{t('materials.download')}</a>}
		</div>
	</div>
</article>
