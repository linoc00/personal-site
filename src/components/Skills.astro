---
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import { skills } from '../data/portfolio';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="competenze" class="section-shell scroll-mt-20 border-y border-[var(--line)] bg-[var(--surface-strong)]">
	<div class="site-container grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
	<div><p class="eyebrow">{t('skills.eyebrow')}</p><h2 class="section-title">{t('skills.title')}</h2><p class="section-copy">{t('skills.subtitle')}</p></div>
	<div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
		{
			skills.map((category) => (
				<div class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-5 lg:grid lg:grid-cols-[9rem_1fr] lg:items-start lg:gap-4">
					<h3 class="text-lg font-bold text-[var(--ink)]">
						{category.title[locale]}
					</h3>
					<ul class="mt-3 flex flex-wrap gap-2 lg:mt-0">
						{category.items.map((item) => (
							<li class="rounded-lg bg-[var(--surface-strong)] px-2.5 py-1 text-sm text-[var(--muted)]">
								{item}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	</div>
</section>
