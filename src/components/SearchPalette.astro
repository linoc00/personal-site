---
import { getCollection } from 'astro:content';
import { localizedMaterials, localizedContent, contentKey } from '../i18n/content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { projects } from '../data/portfolio';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const materials = localizedMaterials(await getCollection('materials'), locale);
const posts = localizedContent(await getCollection('blog'), locale);
const home = getRelativeLocaleUrl(locale, '/');

const entries = [
	{ title: t('nav.materials'), description: t('materials.subtitle'), category: t('nav.materials'), href: getRelativeLocaleUrl(locale, '/didattica/') },
	{ title: t('nav.projects'), description: t('projects.subtitle'), category: t('nav.home'), href: getRelativeLocaleUrl(locale, '/progetti/') },
	{ title: t('nav.skills'), description: t('skills.subtitle'), category: t('nav.home'), href: `${home}#competenze` },
	{ title: t('nav.experience'), description: t('experience.subtitle'), category: t('nav.home'), href: `${home}#esperienza` },
	{ title: t('nav.blog'), description: t('blog.subtitle'), category: t('nav.blog'), href: getRelativeLocaleUrl(locale, '/blog/') },
	...materials.map(({ data }) => ({ title: data.title, description: `${data.description} ${data.topics.join(' ')}`, category: data.category, href: data.href })),
	...posts.map((post) => ({ title: post.data.title, description: post.data.description, category: t('nav.blog'), href: `/${locale}/blog/${contentKey(post)}/` })),
	...projects.map((project) => ({ title: project.title[locale], description: `${project.description[locale]} ${project.tech.join(' ')}`, category: t('nav.projects'), href: `${getRelativeLocaleUrl(locale, '/progetti/')}#${project.slug}` })),
];
---

<dialog
	id="site-search"
	data-no-results={t('search.noResults')}
	aria-label={t('search.dialog')}
	class="m-auto w-[min(42rem,calc(100%-2rem))] overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--surface-strong)] p-0 text-[var(--ink)] shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm"
>
	<div class="flex items-center gap-3 border-b border-[var(--line)] px-4 sm:px-5">
		<svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-[var(--muted)]" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
		<input id="site-search-input" type="search" autocomplete="off" placeholder={t('search.placeholder')} class="h-16 min-w-0 flex-1 bg-transparent text-base text-[var(--ink)] outline-none placeholder:text-[var(--muted)]" />
		<button type="button" data-search-close class="rounded-md border border-[var(--line)] px-2 py-1 text-xs font-semibold text-[var(--muted)] hover:text-[var(--ink)]">Esc</button>
	</div>
	<div class="max-h-[min(60vh,30rem)] overflow-y-auto p-2" data-search-results aria-live="polite"></div>
	<div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-[var(--line)] px-4 py-3 text-xs text-[var(--muted)] sm:px-5">
		<span><kbd class="font-sans">↑↓</kbd> {t('search.navigate')}</span>
		<span><kbd class="font-sans">↵</kbd> {t('search.open')}</span>
		<span class="ml-auto">{t('search.hint')}</span>
	</div>
	<script type="application/json" data-search-data set:html={JSON.stringify(entries).replace(/</g, '\\u003c')} />
</dialog>

<script>
	interface SearchEntry { title: string; description: string; category: string; href: string; }
	const dialog = document.querySelector<HTMLDialogElement>('#site-search');
	const input = dialog?.querySelector<HTMLInputElement>('#site-search-input');
	const results = dialog?.querySelector<HTMLElement>('[data-search-results]');
	const dataNode = dialog?.querySelector<HTMLScriptElement>('[data-search-data]');
	const noResults = dialog?.dataset.noResults || 'No results';
	let activeIndex = 0;
	let entries: SearchEntry[] = [];
	try { entries = JSON.parse(dataNode?.textContent || '[]'); } catch {}

	const normalize = (value: string) => value.toLocaleLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
	const filtered = () => {
		const query = normalize(input?.value.trim() || '');
		return (query ? entries.filter((entry) => normalize(`${entry.title} ${entry.description} ${entry.category}`).includes(query)) : entries).slice(0, 9);
	};
	const entities: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' };
	const escapeHtml = (value: string) => String(value).replace(/[&<>'"]/g, (char) => entities[char] ?? char);

	function render() {
		if (!results) return;
		const items = filtered();
		activeIndex = Math.min(activeIndex, Math.max(items.length - 1, 0));
		results.innerHTML = items.length ? items.map((entry, index) => `
			<a href="${escapeHtml(entry.href)}" data-search-result data-active="${index === activeIndex}" class="group flex items-start gap-3 rounded-xl px-3 py-3 transition-colors data-[active=true]:bg-[var(--brand-soft)]">
				<span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[var(--line)] bg-[var(--surface)] text-[var(--brand)]">↗</span>
				<span class="min-w-0"><span class="block truncate font-semibold text-[var(--ink)]">${escapeHtml(entry.title)}</span><span class="mt-0.5 block truncate text-sm text-[var(--muted)]">${escapeHtml(entry.category)} · ${escapeHtml(entry.description)}</span></span>
			</a>`).join('') : `<p class="px-4 py-10 text-center text-sm text-[var(--muted)]">${escapeHtml(noResults)}</p>`;
	}

	function openSearch() { if (dialog && !dialog.open) { activeIndex = 0; dialog.showModal(); render(); requestAnimationFrame(() => input?.focus()); } }
	function closeSearch() { dialog?.close(); }
	results?.addEventListener('click', (event) => {
		if ((event.target as Element).closest('[data-search-result]')) closeSearch();
	});

	document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', openSearch));
	dialog?.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);
	dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeSearch(); });
	input?.addEventListener('input', () => { activeIndex = 0; render(); });
	input?.addEventListener('keydown', (event: KeyboardEvent) => {
		const count = filtered().length;
		if (event.key === 'ArrowDown' && count) { event.preventDefault(); activeIndex = (activeIndex + 1) % count; render(); }
		if (event.key === 'ArrowUp' && count) { event.preventDefault(); activeIndex = (activeIndex - 1 + count) % count; render(); }
		if (event.key === 'Enter') { event.preventDefault(); dialog?.querySelectorAll<HTMLAnchorElement>('[data-search-result]')[activeIndex]?.click(); }
	});
	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); dialog?.open ? closeSearch() : openSearch(); }
	});
</script>
